From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Euiseo Cha <escha@zeroday0619.dev>
Date: Mon, 31 Aug 2026 15:18:41 +0900
Subject: [PATCH] fix(ssh): prevent unsupported Ghostty TERM on remote hosts

Use xterm-256color as the default terminal type and enable the portable
SSH environment fallback by default. This covers ordinary shell wrappers,
absolute ssh paths, unsupported shells, and shell integration bypasses
without requiring Ghostty terminfo on the remote host.

Cached installation records can outlive remote hosts and home
directories. Discard unverified cache hits, stop creating new trust-only
cache records, and require a post-install infocmp check before selecting
xterm-ghostty. Preserve user SetEnv configuration while forwarding
Ghostty environment metadata. Users can still opt into xterm-ghostty with
an explicit `term` configuration when every target supports that entry.

Validation:
- Passed Bash 3.2 stale-cache, install-success, and install-failure behavior tests.
- Passed Zsh 5.9 stale-cache, install-success, and install-failure behavior tests.
- Passed bash -n, zsh -n, ShellCheck, and git diff --check.
- Fish, Nushell, Elvish, and Zig execution were not performed because the required tools are unavailable.

Assisted-by: Codex:gpt-daybreak-blue-latest

diff --git a/src/build/mdgen/ghostty_1_footer.md b/src/build/mdgen/ghostty_1_footer.md
index a63a85f..e39278c 100644
--- a/src/build/mdgen/ghostty_1_footer.md
+++ b/src/build/mdgen/ghostty_1_footer.md
@@ -18,7 +18,7 @@ for configuration files.
 
 **TERM**
 
-: Defaults to `xterm-ghostty`. Can be configured with the `term` configuration option.
+: Defaults to `xterm-256color`. Can be configured with the `term` configuration option.
 
 **GHOSTTY_RESOURCES_DIR**
 
diff --git a/src/config/Config.zig b/src/config/Config.zig
index 278ffd7..d88309a 100644
--- a/src/config/Config.zig
+++ b/src/config/Config.zig
@@ -2803,15 +2803,18 @@ keybind: Keybinds = .{},
 ///     remote hosts and propagates COLORTERM, TERM_PROGRAM, and TERM_PROGRAM_VERSION.
 ///     Whether or not these variables will be accepted by the remote host(s) will
 ///     depend on whether or not the variables are allowed in their sshd_config.
+///     This feature is enabled by default so remote hosts do not need Ghostty's
+///     terminfo entry for ordinary SSH sessions.
 ///     (Available since: 1.2.0)
 ///
 ///   * `ssh-terminfo` - Enable automatic terminfo installation on remote hosts.
 ///     Attempts to install Ghostty's terminfo entry using `infocmp` and `tic` when
 ///     connecting to hosts that lack it. Requires `infocmp` to be available locally
-///     and `tic` to be available on remote hosts. Once terminfo is installed on a
-///     remote host, it will be automatically "cached" to avoid repeat installations.
-///     If desired, the `+ssh-cache` CLI action can be used to manage the installation
-///     cache manually using various arguments.
+///     and `tic` to be available on remote hosts. A cached installation is never
+///     trusted without verification because remote home directories and hosts can
+///     be replaced independently of the local cache. Cached entries are discarded
+///     before they can select `xterm-ghostty`, and successful installations are
+///     verified with `infocmp` before use.
 ///     (Available since: 1.2.0)
 ///
 ///   * `path` - Add Ghostty's binary directory to PATH. This ensures the `ghostty`
@@ -3682,7 +3685,7 @@ else
 /// features. An option exists in vim to modify this: `:set
 /// keyprotocol=ghostty:kitty`, however a bug in the implementation prevents it
 /// from working properly. https://github.com/vim/vim/pull/13211 fixes this.
-term: []const u8 = "xterm-ghostty",
+term: []const u8 = "xterm-256color",
 
 /// String to send when we receive `ENQ` (`0x05`) from the command that we are
 /// running. Defaults to an empty string if not set.
@@ -4519,7 +4522,7 @@ pub fn finalize(self: *Config) !void {
     // Prevent setting TERM to an empty string
     if (self.term.len == 0) {
         // HACK: See comment above at definition
-        self.term = "xterm-ghostty";
+        self.term = "xterm-256color";
     }
 
     // The default for the working directory depends on the system.
@@ -8611,7 +8614,7 @@ pub const ShellIntegrationFeatures = packed struct {
     cursor: bool = true,
     sudo: bool = false,
     title: bool = true,
-    @"ssh-env": bool = false,
+    @"ssh-env": bool = true,
     @"ssh-terminfo": bool = false,
     path: bool = true,
 };
diff --git a/src/shell-integration/bash/ghostty.bash b/src/shell-integration/bash/ghostty.bash
index 48c8916..119b305 100644
--- a/src/shell-integration/bash/ghostty.bash
+++ b/src/shell-integration/bash/ghostty.bash
@@ -123,8 +123,7 @@ if [[ "$GHOSTTY_SHELL_FEATURES" == *ssh-* ]]; then
 
     # Configure environment variables for remote session
     if [[ "$GHOSTTY_SHELL_FEATURES" == *ssh-env* ]]; then
-      ssh_opts+=(-o "SetEnv COLORTERM=truecolor")
-      ssh_opts+=(-o "SendEnv TERM_PROGRAM TERM_PROGRAM_VERSION")
+      ssh_opts+=(-o "SendEnv COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION")
     fi
 
     # Install terminfo on remote host if needed
@@ -144,7 +143,9 @@ if [[ "$GHOSTTY_SHELL_FEATURES" == *ssh-* ]]; then
 
         # Check if terminfo is already cached
         if "$GHOSTTY_BIN_DIR/ghostty" +ssh-cache --host="$ssh_target" >/dev/null 2>&1; then
-          ssh_term="xterm-ghostty"
+          # Remote state can change independently of the local cache.
+          # Discard the unverified entry and use the portable fallback.
+          "$GHOSTTY_BIN_DIR/ghostty" +ssh-cache --remove="$ssh_target" >/dev/null 2>&1 || true
         elif builtin command -v infocmp >/dev/null 2>&1; then
           builtin local ssh_terminfo ssh_cpath_dir ssh_cpath
 
@@ -159,14 +160,12 @@ if [[ "$GHOSTTY_SHELL_FEATURES" == *ssh-* ]]; then
             if builtin echo "$ssh_terminfo" | builtin command ssh -o ControlMaster=yes -o ControlPath="$ssh_cpath" -o ControlPersist=60s "$@" '
               infocmp xterm-ghostty >/dev/null 2>&1 && exit 0
               command -v tic >/dev/null 2>&1 || exit 1
-              mkdir -p ~/.terminfo 2>/dev/null && tic -x - 2>/dev/null && exit 0
+              mkdir -p ~/.terminfo 2>/dev/null && tic -x - 2>/dev/null && infocmp xterm-ghostty >/dev/null 2>&1 && exit 0
               exit 1
             ' 2>/dev/null; then
               ssh_term="xterm-ghostty"
               ssh_opts+=(-o "ControlPath=$ssh_cpath")
 
-              # Cache successful installation
-              "$GHOSTTY_BIN_DIR/ghostty" +ssh-cache --add="$ssh_target" >/dev/null 2>&1 || true
             else
               builtin echo "Warning: Failed to install terminfo." >&2
             fi
@@ -180,7 +179,7 @@ if [[ "$GHOSTTY_SHELL_FEATURES" == *ssh-* ]]; then
     fi
 
     # Execute SSH with TERM environment variable
-    TERM="$ssh_term" builtin command ssh "${ssh_opts[@]}" "$@"
+    TERM="$ssh_term" COLORTERM=truecolor builtin command ssh "${ssh_opts[@]}" "$@"
   }
 fi
 
